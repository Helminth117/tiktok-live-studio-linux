#!/usr/bin/env bash
# Lanzador de TikTok LIVE Studio (Windows) en Linux mediante umu-launcher/Proton.
#
# Uso:
#   tiktok-live-studio                 abre la app (la instala o actualiza si hace falta)
#   tiktok-live-studio install [EXE]   ejecuta el instalador oficial en el prefijo
#   tiktok-live-studio winecfg         abre winecfg del prefijo
#   tiktok-live-studio winetricks ...  ejecuta winetricks en el prefijo
#   tiktok-live-studio reset           borra el prefijo (se pierde la sesión)
#   tiktok-live-studio cambiar-captura vuelve a preguntar qué mostrar en una
#                                      "Display capture"
#   tiktok-live-studio nueva-captura   crea otra captura y da la dirección para
#                                      añadirla en TikTok con la fuente "Link"
#   tiktok-live-studio activar-deteccion
#                                      en Hyprland, hace que una captura encuentre
#                                      sola su app cuando se cierra y se reabre
#   tiktok-live-studio desactivar-deteccion
#                                      deja el selector de pantalla que había antes
#
# Variables: TTLS_PREFIX (ruta del prefijo), PROTONPATH (por defecto GE-Proton11-11,
#            que se descarga si falta; con otro valor no hay captura de pantalla),
#            TTLS_MMDEVAPI, TTLS_WINEX11, TTLS_CAPTURE_HELPER (archivos parcheados).
set -euo pipefail

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tiktok-live-studio"
export WINEPREFIX="${TTLS_PREFIX:-$DATA_DIR/prefix}"
export GAMEID="${GAMEID:-umu-default}"
# sscronet.dll importa SetPerTcp6ConnectionEStats, que Wine añadió en 10.15;
# UMU-Proton 10.0 no la tiene y la app aborta al iniciar. La versión queda fija
# porque mmdevapi.dll está compilada contra el Wine de esta release. umu solo
# descarga "la última", así que esta se descarga aquí.
PROTON_RELEASE=GE-Proton11-11
PROTON_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/Steam/compatibilitytools.d/$PROTON_RELEASE-x86_64"
PROTON_URL="https://github.com/GloriousEggroll/proton-ge-custom/releases/download/$PROTON_RELEASE/$PROTON_RELEASE-x86_64"
# mmdevapi de GE-Proton11-11 con IDeviceTopology/IConnector/IPart implementados:
# sin ellos MediaSDK descarta todos los dispositivos de audio ("No audio found").
MMDEVAPI_DLL="${TTLS_MMDEVAPI:-/usr/share/tiktok-live-studio/mmdevapi.dll}"
# winex11.so de GE-Proton11-11 que, en Wayland, toma la imagen del escritorio
# de tiktok-live-studio-capture (portal ScreenCast + PipeWire) en vez de la
# ventana raíz de X, que sale negra. Va en una copia de GE-Proton con enlaces duros.
WINEX11_SO="${TTLS_WINEX11:-/usr/share/tiktok-live-studio/winex11.so}"
CAPTURE_HELPER="${TTLS_CAPTURE_HELPER:-/usr/lib/tiktok-live-studio/tiktok-live-studio-capture}"
PICKER="${TTLS_PICKER:-/usr/lib/tiktok-live-studio/tiktok-live-studio-picker}"
XDPH_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/xdph.conf"
# El selector que había antes: tiktok-live-studio-picker lo abre cuando hay que preguntar.
PICKER_FALLBACK="${XDG_CONFIG_HOME:-$HOME/.config}/tiktok-live-studio/picker-fallback"
CAPTURE_PROTON_DIR="$DATA_DIR/proton"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tiktok-live-studio"
DOWNLOAD_URL="https://www.tiktok.com/studio/download"
SETTINGS_URL="https://webcast.tiktokv.com/service/settings/v3/?app=1&aid=8311&device_platform=win&from_aid=8311&version_code=0.0.0"

die() {
    if [[ -t 2 ]] || ! command -v zenity >/dev/null; then
        printf 'error: %s\n' "$*" >&2
    else
        zenity --error --title="TikTok LIVE Studio" --text="$*" 2>/dev/null || true
    fi
    exit 1
}

find_app() {
    [[ -d "$WINEPREFIX/drive_c" ]] || return 1
    local exe
    for name in "TikTok LIVE Studio Launcher.exe" "TikTok LIVE Studio.exe"; do
        exe=$(find "$WINEPREFIX/drive_c" -iname "$name" -print -quit 2>/dev/null)
        [[ -n "$exe" ]] && { printf '%s\n' "$exe"; return 0; }
    done
    return 1
}

find_installer() {
    local dl
    dl=$(xdg-user-dir DOWNLOAD 2>/dev/null || echo "$HOME/Downloads")
    # El más reciente de los instaladores oficiales descargados.
    ls -t "$dl"/tiktok_live_studio*.exe "$HOME"/Downloads/tiktok_live_studio*.exe \
        2>/dev/null | head -n1 || true
}

# curl con reanudación: el CDN de TikTok corta las descargas largas.
download() {
    local url=$1 dest=$2 try
    shift 2
    for try in {1..20}; do
        curl -fL -C - --connect-timeout 20 "$@" -o "$dest" "$url" && return 0
        echo "Conexión interrumpida; reanudando ($try/20) ..." >&2
        sleep 3
    done
    return 1
}

ensure_proton() {
    local tmp sum extract

    if [[ -n "${PROTONPATH:-}" ]]; then
        export PROTONPATH
        return 0
    fi
    if [[ ! -f "$PROTON_DIR/toolmanifest.vdf" ]]; then
        tmp=$(mktemp -d)
        echo "Descargando $PROTON_RELEASE ..." >&2
        if [[ -t 2 ]] || ! command -v zenity >/dev/null; then
            download "$PROTON_URL.tar.gz" "$tmp/proton.tar.gz" >&2 || die "No se pudo descargar $PROTON_RELEASE."
        else
            download "$PROTON_URL.tar.gz" "$tmp/proton.tar.gz" -sS | zenity --progress --pulsate --auto-close --no-cancel \
                --title="TikTok LIVE Studio" --text="Descargando $PROTON_RELEASE ..." 2>/dev/null
            [[ ${PIPESTATUS[0]} -eq 0 ]] || die "No se pudo descargar $PROTON_RELEASE."
        fi
        sum=$(curl -fsSL "$PROTON_URL.sha512sum" | cut -d' ' -f1) || die "No se pudo descargar el SHA-512 de $PROTON_RELEASE."
        [[ "$(sha512sum "$tmp/proton.tar.gz" | cut -d' ' -f1)" == "$sum" ]] || die "El SHA-512 de $PROTON_RELEASE no coincide."
        # Se extrae aparte: una extracción cortada no debe parecer una instalación completa.
        extract="$PROTON_DIR.tmp"
        rm -rf -- "${extract:?}"
        mkdir -p "$extract"
        tar -xzf "$tmp/proton.tar.gz" -C "$extract"
        rm -rf "$tmp"
        [[ -f "$extract/${PROTON_DIR##*/}/toolmanifest.vdf" ]] || die "$PROTON_RELEASE no quedó en $extract."
        rm -rf -- "${PROTON_DIR:?}"
        mv "$extract/${PROTON_DIR##*/}" "$PROTON_DIR"
        rm -rf -- "${extract:?}"
    fi
    export PROTONPATH="$PROTON_DIR"
    ensure_capture_proton
}

# Copia de GE-Proton en la que solo cambia winex11.so; con enlaces duros casi
# no ocupa disco y GE-Proton queda intacto.
ensure_capture_proton() {
    local so=files/lib/wine/x86_64-unix/winex11.so tmp="$CAPTURE_PROTON_DIR.tmp"

    [[ -f "$WINEX11_SO" ]] || { echo "aviso: no existe $WINEX11_SO; no habrá captura de pantalla" >&2; return 0; }
    if ! cmp -s "$WINEX11_SO" "$CAPTURE_PROTON_DIR/$so"; then
        mkdir -p "$DATA_DIR"
        rm -rf -- "${tmp:?}"
        cp -al "$PROTON_DIR" "$tmp" 2>/dev/null || cp -a --reflink=auto "$PROTON_DIR" "$tmp"
        rm -f -- "${tmp:?}/$so"
        cp "$WINEX11_SO" "$tmp/$so"
        rm -rf -- "${CAPTURE_PROTON_DIR:?}"
        mv "$tmp" "$CAPTURE_PROTON_DIR"
    fi
    export PROTONPATH="$CAPTURE_PROTON_DIR"
}

start_capture_helper() {
    [[ -x "$CAPTURE_HELPER" && "$PROTONPATH" == "$CAPTURE_PROTON_DIR" ]] || return 0
    export WINE_SCREEN_CAPTURE_SHM="/dev/shm/tiktok-live-studio-capture-$(id -u)"
    "$CAPTURE_HELPER" &
    CAPTURE_PID=$!
}

# Descarga el instalador completo más reciente desde el servidor de
# actualizaciones de TikTok y verifica su MD5. Imprime la ruta del .exe.
fetch_installer() {
    local info url md5 version dest
    info=$(curl -fsS "$SETTINGS_URL" | jq -r '.data.settings.live_studio_downloader_windows | "\(.url) \(.md5) \(.version)"') || return 1
    read -r url md5 version <<<"$info"
    [[ "$url" == https://* ]] || return 1

    mkdir -p "$CACHE_DIR"
    dest="$CACHE_DIR/tiktok_live_studio-$version-x64.exe"
    if [[ -f "$dest" ]] && [[ "$(md5sum "$dest" | cut -d' ' -f1)" == "$md5" ]]; then
        printf '%s\n' "$dest"; return 0
    fi

    echo "Descargando TikTok LIVE Studio $version ..." >&2
    if [[ -t 2 ]] || ! command -v zenity >/dev/null; then
        download "$url" "$dest.part" >&2 || return 1
    else
        download "$url" "$dest.part" -sS | zenity --progress --pulsate --auto-close --no-cancel \
            --title="TikTok LIVE Studio" --text="Descargando TikTok LIVE Studio $version ..." 2>/dev/null
        [[ ${PIPESTATUS[0]} -eq 0 ]] || return 1
    fi
    [[ "$(md5sum "$dest.part" | cut -d' ' -f1)" == "$md5" ]] || { rm -f "$dest.part"; die "El MD5 del instalador descargado no coincide."; }
    mv "$dest.part" "$dest"
    printf '%s\n' "$dest"
}

install_app() {
    local installer="${1:-}"
    [[ -z "$installer" ]] && installer=$(fetch_installer || true)
    [[ -z "$installer" ]] && installer=$(find_installer)
    if [[ -z "$installer" ]] && command -v zenity >/dev/null && [[ ! -t 2 ]]; then
        zenity --question --title="TikTok LIVE Studio" \
            --text="No se encontró el instalador.\n\nDescárgalo desde $DOWNLOAD_URL y luego selecciónalo." \
            --ok-label="Abrir página" --cancel-label="Ya lo tengo" 2>/dev/null \
            && { xdg-open "$DOWNLOAD_URL" >/dev/null 2>&1 & }
        installer=$(zenity --file-selection --title="Selecciona el instalador de TikTok LIVE Studio" \
            --file-filter="Instalador (*.exe) | *.exe" 2>/dev/null) || exit 1
    fi
    [[ -n "$installer" ]] || die "No se encontró el instalador. Descárgalo desde $DOWNLOAD_URL y ejecuta: tiktok-live-studio install RUTA.exe"
    [[ -f "$installer" ]] || die "No existe: $installer"

    mkdir -p "$WINEPREFIX"
    echo "Instalando con $installer en $WINEPREFIX ..." >&2
    # La interfaz del instalador completo se dibuja en negro con Proton;
    # en modo silencioso (/S de NSIS) instala sin ella.
    case "$(basename "$installer")" in
        tiktok_live_studio_downloader*) umu-run "$installer" ;;
        *) umu-run "$installer" /S ;;
    esac
    find_app >/dev/null || die "El instalador terminó pero no se encontró TikTok LIVE Studio en el prefijo."
}

app_running() {
    # Con awk se lee todo ps: "grep -q" lo cortaría y pipefail daría falso negativo.
    ps -eo args= | awk '/^[Cc]:\\.*TikTok LIVE Studio\.exe/ { found = 1 } END { exit !found }'
}

# El actualizador de la app abre una descarga que no se puede cerrar y luego su
# instalador, que con Proton se dibuja en negro. Se adelanta instalando aquí, en
# silencio, la versión que ofrece el servidor (también si es una anterior, como
# cuando TikTok retira una versión: la app pediría volver a ella de todos modos).
# Sin red o si algo falla, abre la versión que ya está instalada.
update_app() {
    local config latest current installer

    app_running && return 0
    config=$(dirname "$(find_app)")/launcher_config.json
    current=$(jq -r '.cur_path // empty' "$config" 2>/dev/null) || return 0
    latest=$(curl -fsS --max-time 15 "$SETTINGS_URL" |
        jq -r '.data.settings.live_studio_downloader_windows.version // empty') || return 0
    [[ -n "$current" && "$latest" == [0-9]* && "$latest" != "$current" ]] || return 0

    echo "Actualizando TikTok LIVE Studio de $current a $latest ..." >&2
    installer=$(fetch_installer) || { echo "aviso: no se pudo descargar $latest; se abre $current" >&2; return 0; }
    # En subshell: un error dentro de install_app no debe impedir abrir lo instalado.
    if [[ -t 2 ]] || ! command -v zenity >/dev/null; then
        ( install_app "$installer" ) || echo "aviso: no se pudo instalar $latest; se abre $current" >&2
    else
        ( install_app "$installer" 2>/dev/null ) | zenity --progress --pulsate --auto-close --no-cancel \
            --title="TikTok LIVE Studio" --text="Instalando la versión $latest ..." 2>/dev/null ||
            echo "aviso: no se pudo instalar $latest; se abre $current" >&2
    fi
}

# Cada Display capture es una ranura del ayudante (ver tiktok-live-studio-capture).
change_capture() {
    local base="/dev/shm/tiktok-live-studio-capture-$(id -u)" status name slot choice i n=0
    local -a names=() rows=()

    while read -r status; do
        name=${status#"$base."}; name=${name%.status}
        n=$((n + 1))
        names+=("$name")
        if [[ "$name" == 1 ]]; then
            rows+=("Display capture: $(<"$status")")
        else
            rows+=("Captura $name (Link): $(<"$status")")
        fi
    done < <(find /dev/shm -maxdepth 1 -name "${base##*/}.*.status" | sort -t. -k2 -n)

    if ((n == 0)); then
        if [[ -t 2 ]] || ! command -v zenity >/dev/null; then
            echo "No hay ninguna Display capture activa: abre TikTok y añade una." >&2
        else
            zenity --info --title="TikTok LIVE Studio" --text="No hay ninguna Display capture activa: abre TikTok y añade una." 2>/dev/null
        fi
        return 1
    elif ((n == 1)); then
        slot=${names[0]}
    elif [[ ! -t 0 ]] && command -v zenity >/dev/null; then
        choice=$(zenity --list --title="TikTok LIVE Studio" --text="¿Qué fuente quieres cambiar?" \
            --column="Fuente" "${rows[@]}" 2>/dev/null) || return 1
        for ((i = 0; i < n; i++)); do [[ "${rows[i]}" == "$choice" ]] && slot=${names[i]}; done
    else
        select choice in "${rows[@]}"; do
            [[ -n "$choice" ]] && { slot=${names[REPLY - 1]}; break; }
        done
    fi
    [[ -n "${slot:-}" ]] || return 1
    rm -f -- "$CACHE_DIR/capture.$slot.token" "$CACHE_DIR/capture.$slot.class"
    touch "$base.$slot.reset"
    echo "La captura $slot va a preguntar qué mostrar." >&2
}

# Las capturas extra son páginas locales (ver tiktok-live-studio-capture).
new_capture() {
    local base="/dev/shm/tiktok-live-studio-capture-$(id -u)" n=2 url i message dns_note=""

    # Algunos routers filtran respuestas de DNS que apuntan a 127.0.0.1.
    if [[ "$(getent ahostsv4 lvh.me 2>/dev/null | awk 'NR == 1 { print $1 }')" != 127.0.0.1 ]]; then
        dns_note="\n\nAviso: tu DNS no resuelve lvh.me, así que la fuente Link puede quedarse en blanco. Si pasa, ejecuta en una terminal:\n\necho '127.0.0.1 lvh.me' | sudo tee -a /etc/hosts"
    fi
    pgrep -f '/tiktok-live-studio-capture$' >/dev/null || die "Abre TikTok LIVE Studio primero."
    while [[ -e "$CACHE_DIR/capture.$n.url" ]]; do n=$((n + 1)); done
    touch "$base.$n.request"
    for i in {1..20}; do
        [[ -s "$base.$n.url" ]] && break
        sleep 0.5
    done
    [[ -s "$base.$n.url" ]] || die "El ayudante de captura no respondió."
    url=$(<"$base.$n.url")
    command -v wl-copy >/dev/null && printf '%s' "$url" | wl-copy
    message="Captura $n: elige qué mostrar en el diálogo.\n\nEn TikTok: Add source → Link → pega esta dirección (Ctrl+V)$(command -v wl-copy >/dev/null && echo ', ya está copiada'):\n\n$url\n\nActiva Custom resolution con 1920×1080 para que se vea nítida.$dns_note"
    if [[ -t 2 ]] || ! command -v zenity >/dev/null; then
        printf '%b\n' "$message" >&2
    else
        zenity --info --title="TikTok LIVE Studio" --text="$message" 2>/dev/null || true
    fi
}

# El selector del portal se configura en un archivo del usuario.
current_picker() {
    sed -nE 's/^[[:space:]]*custom_picker_binary[[:space:]]*=[[:space:]]*//p' "$XDPH_CONF" 2>/dev/null |
        sed -E 's/[[:space:]]*(#.*)?$//' | head -n1 || true
}

# Reemplaza xdph.conf con lo que llega por la entrada, con copia y sin escribir en sitio.
replace_xdph_conf() {
    local file tmp backup="$XDPH_CONF.bak-$(date +%Y%m%d)"

    file=$(readlink -f -- "$XDPH_CONF")
    tmp=$(mktemp "$file.XXXXXX")
    cat >"$tmp"
    if [[ -f "$file" ]]; then
        [[ -e "$backup" ]] || cp -- "$file" "$backup"
        chmod --reference="$file" "$tmp"
    else
        chmod 644 "$tmp"
    fi
    mv -- "$tmp" "$file"
}

# Escapa un texto para usarlo como reemplazo en "s|...|...|" de sed.
sed_escape() {
    printf '%s' "$1" | sed 's/[&|\\]/\\&/g'
}

set_picker_line() {
    sed -E "s|^([[:space:]]*custom_picker_binary[[:space:]]*=[[:space:]]*).*|\1$(sed_escape "$1")|" "$XDPH_CONF"
}

enable_detection() {
    local current

    current=$(current_picker)
    [[ "$current" == "$PICKER" ]] && { echo "Ya está activada." >&2; return 0; }
    mkdir -p "$(dirname "$XDPH_CONF")" "$(dirname "$PICKER_FALLBACK")"
    if [[ -n "$current" ]]; then
        printf '%s\n' "$current" >"$PICKER_FALLBACK"
        set_picker_line "$PICKER" | replace_xdph_conf
    else
        rm -f -- "$PICKER_FALLBACK"
        if grep -qE '^[[:space:]]*screencopy[[:space:]]*\{' "$XDPH_CONF" 2>/dev/null; then
            sed -E "0,/^[[:space:]]*screencopy[[:space:]]*\{/s||&\n    custom_picker_binary = $(sed_escape "$PICKER")|" "$XDPH_CONF" | replace_xdph_conf
        else
            { cat -- "$XDPH_CONF" 2>/dev/null || true
              printf 'screencopy {\n    custom_picker_binary = %s\n}\n' "$PICKER"; } | replace_xdph_conf
        fi
    fi
    systemctl --user restart xdg-desktop-portal-hyprland
    echo "Listo: las capturas de ventana encontrarán su app al reabrirla." >&2
}

disable_detection() {
    local fallback=""

    [[ "$(current_picker)" == "$PICKER" ]] || { echo "No está activada." >&2; return 0; }
    [[ -f "$PICKER_FALLBACK" ]] && fallback=$(<"$PICKER_FALLBACK")
    if [[ -n "$fallback" ]]; then
        set_picker_line "$fallback" | replace_xdph_conf
    else
        # Sin la línea, un bloque que quede vacío también era nuestro.
        sed -E '/^[[:space:]]*custom_picker_binary[[:space:]]*=/d' "$XDPH_CONF" |
            sed -E '/^screencopy \{$/{N;/\n\}$/d}' | replace_xdph_conf
        [[ -s "$XDPH_CONF" ]] || rm -f -- "$XDPH_CONF"
    fi
    rm -f -- "$PICKER_FALLBACK"
    systemctl --user restart xdg-desktop-portal-hyprland
    echo "Listo: el portal vuelve a usar el selector de antes." >&2
}

install_mmdevapi() {
    local dst="$WINEPREFIX/drive_c/windows/system32/mmdevapi.dll"

    [[ -f "$MMDEVAPI_DLL" ]] || { echo "aviso: no existe $MMDEVAPI_DLL; el audio no funcionará" >&2; return 0; }
    cmp -s "$MMDEVAPI_DLL" "$dst" && return 0
    # Proton deja ahí un enlace a su DLL; se reemplaza el enlace, no su destino.
    rm -f "$dst"
    cp "$MMDEVAPI_DLL" "$dst"
}

# Con monitores que no empiezan en x=0, Wine coloca la ventana donde no hay pantalla, y
# la devuelve ahí si se mueve mientras flota. Acoplada, la posición la decide Hyprland.
offscreen_window() {
    jq -nr --argjson monitors "$(hyprctl monitors -j)" --argjson clients "$(hyprctl clients -j)" '
        [$clients[] | select(.class == "steam_app_default" and .title == "TikTok LIVE Studio" and .floating) |
            . as $w | select(all($monitors[];
                $w.at[0] + $w.size[0] <= .x or $w.at[0] >= .x + .width or
                $w.at[1] + $w.size[1] <= .y or $w.at[1] >= .y + .height))][0].address // empty'
}

keep_window_visible() {
    local address

    [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl >/dev/null || return 0
    while kill -0 $$ 2>/dev/null; do
        sleep 2
        address=$(offscreen_window 2>/dev/null) || continue
        [[ -n "$address" ]] || continue
        # Hyprland con configuración en Lua usa la primera forma; las versiones anteriores, la segunda.
        hyprctl dispatch "hl.dsp.window.float({ action = \"toggle\", window = \"address:$address\" })" 2>/dev/null | grep -qx ok ||
            hyprctl dispatch togglefloating "address:$address" >/dev/null 2>&1 || true
    done
}

run_app() {
    local exe
    if find_app >/dev/null; then update_app; else install_app "${1:-}"; fi
    exe=$(find_app)
    install_mmdevapi
    export WINEDLLOVERRIDES="mmdevapi=n,b${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"
    start_capture_helper
    keep_window_visible &
    cd "$(dirname "$exe")"
    [[ -n "${CAPTURE_PID:-}" ]] || exec umu-run "$exe"
    # Puede haber salido ya, si otra ventana de la app tiene el ayudante.
    trap 'kill "$CAPTURE_PID" 2>/dev/null || true' EXIT
    umu-run "$exe"
}

case "${1:-}" in
    install) shift; ensure_proton; install_app "${1:-}" ;;
    winecfg) ensure_proton; exec umu-run winecfg ;;
    winetricks) shift; ensure_proton; exec umu-run winetricks "$@" ;;
    reset)
        read -rp "¿Borrar $WINEPREFIX? [s/N] " ans
        if [[ "$ans" == [sS] ]]; then rm -rf -- "$WINEPREFIX"; echo "Prefijo borrado."; fi ;;
    cambiar-captura) change_capture ;;
    nueva-captura) new_capture ;;
    activar-deteccion) enable_detection ;;
    desactivar-deteccion) disable_detection ;;
    -h|--help) sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0" ;;
    *) ensure_proton; run_app "${1:-}" ;;
esac
