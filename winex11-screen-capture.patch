+/* Under Wayland the X root window holds none of the native windows, so a
+ * capture of the desktop is black. When WINE_SCREEN_CAPTURE_SHM is set, reads
+ * of the root window come instead from frames that a helper process gets
+ * through the screencast portal and writes to that shared memory file. */
+struct capture_header
+{
+    UINT magic;
+    UINT version;
+    UINT seq;       /* odd while the helper writes a frame */
+    UINT width;
+    UINT height;
+    UINT stride;
+    UINT format;    /* 0: BGRx */
+    UINT reserved;
+    UINT64 last_read;
+};
+
+#define CAPTURE_MAGIC  0x43534c54
+#define CAPTURE_HEADER 64
+
+static BOOL capture_path( char *path, size_t len, const char *suffix )
+{
+    const char *base = getenv( "WINE_SCREEN_CAPTURE_SHM" );
+    return base && snprintf( path, len, "%s.1%s", base, suffix ) < len;
+}
+
+static struct capture_header *capture_map( size_t *size )
+{
+    static struct capture_header *header;
+    static size_t header_size;
+    static time_t last_try;
+    char path[1024];
+    struct stat st;
+    void *ptr;
+    int fd;
+
+    if (header) goto done;
+    if (time( NULL ) == last_try) return NULL;
+    last_try = time( NULL );
+
+    if (!capture_path( path, sizeof(path), "" )) return NULL;
+    if ((fd = open( path, O_RDWR )) == -1) return NULL;
+    if (!fstat( fd, &st ) && st.st_size > CAPTURE_HEADER &&
+        (ptr = mmap( NULL, st.st_size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 )) != MAP_FAILED)
+    {
+        if (((struct capture_header *)ptr)->magic == CAPTURE_MAGIC)
+        {
+            header_size = st.st_size;
+            header = ptr;
+        }
+        else munmap( ptr, st.st_size );
+    }
+    close( fd );
+done:
+    *size = header_size;
+    return header;
+}
+
+static void capture_request(void)
+{
+    char request[1024];
+    int fd;
+
+    if (!capture_path( request, sizeof(request), ".request" )) return;
+    if ((fd = open( request, O_WRONLY | O_CREAT, 0600 )) != -1) close( fd );
+}
+
+/* returns the last captured frame, fitted into width x height keeping its
+ * proportions, or NULL */
+static XImage *get_captured_screen( UINT width, UINT height )
+{
+    static const struct timespec wait = { 0, 500000 };
+    struct capture_header *header;
+    struct timespec now;
+    UINT seq, src_w, src_h, stride, x, y, tries, waits, fit_w, fit_h, off_x, off_y;
+    const BYTE *frame;
+    XImage *image;
+    size_t size;
+    UINT *dst;
+
+    if (!getenv( "WINE_SCREEN_CAPTURE_SHM" )) return NULL;
+    if (!(header = capture_map( &size )))
+    {
+        capture_request();
+        return NULL;
+    }
+    clock_gettime( CLOCK_MONOTONIC, &now );
+    header->last_read = (UINT64)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+
+    if (!(dst = calloc( (size_t)width * height, 4 ))) return NULL;
+    frame = (const BYTE *)header + CAPTURE_HEADER;
+
+    for (tries = 0; tries < 3; tries++)
+    {
+        /* a write takes a few ms; don't give up on the frame in the meantime */
+        for (waits = 0; waits < 10; waits++)
+        {
+            seq = __atomic_load_n( &header->seq, __ATOMIC_ACQUIRE );
+            if (!(seq & 1)) break;
+            nanosleep( &wait, NULL );
+        }
+        src_w = header->width;
+        src_h = header->height;
+        stride = header->stride;
+        if (!src_w || !src_h || header->format ||
+            CAPTURE_HEADER + (size_t)stride * src_h > size || stride < src_w * 4)
+        {
+            capture_request();
+            free( dst );
+            return NULL;
+        }
+        if ((UINT64)src_w * height > (UINT64)src_h * width)
+        {
+            fit_w = width;
+            fit_h = max( (UINT64)src_h * width / src_w, 1 );
+        }
+        else
+        {
+            fit_w = max( (UINT64)src_w * height / src_h, 1 );
+            fit_h = height;
+        }
+        off_x = (width - fit_w) / 2;
+        off_y = (height - fit_h) / 2;
+        for (y = 0; y < fit_h; y++)
+        {
+            const UINT *row = (const UINT *)(frame + (size_t)(y * src_h / fit_h) * stride);
+            UINT *out = dst + (size_t)(y + off_y) * width + off_x;
+            for (x = 0; x < fit_w; x++) out[x] = row[x * src_w / fit_w];
+        }
+        if (__atomic_load_n( &header->seq, __ATOMIC_ACQUIRE ) == seq) break;
+    }
+    /* a frame torn by the next write is still better than the black root window */
+
+    if (!(image = XCreateImage( gdi_display, default_visual.visual, default_visual.depth, ZPixmap, 0,
+                                (char *)dst, width, height, 32, width * 4 )))
+        free( dst );
+    return image;
+}
