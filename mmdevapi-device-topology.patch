+static HRESULT DeviceTopology_Create(IMMDevice *device, IDeviceTopology **ppv)
+{
+    MMDevice *This = impl_from_IMMDevice(device);
+    WCHAR *endpoint_id;
+    HRESULT hr;
+
+    if (FAILED(hr = IMMDevice_GetId(device, &endpoint_id)))
+        return hr;
+    hr = Topology_Create(FALSE, This->flow, endpoint_id, ppv);
+    CoTaskMemFree(endpoint_id);
