+/* Software adapter that every endpoint is connected to, in the format Windows
+ * uses for KS filter device ids. */
+static const WCHAR adapter_idW[] = L"{2}.\\\\?\\root#media#0000#{6994ad04-93ef-11d0-a3cc-00a0c9223196}\\wave";
+
+DEFINE_GUID(mmdevapi_KSNODETYPE_SPEAKER,    0xdff21ce1, 0xf70f, 0x11d0, 0xb9, 0x17, 0x00, 0xa0, 0xc9, 0x22, 0x31, 0x96);
+DEFINE_GUID(mmdevapi_KSNODETYPE_MICROPHONE, 0xdff21be1, 0xf70f, 0x11d0, 0xb9, 0x17, 0x00, 0xa0, 0xc9, 0x22, 0x31, 0x96);
+
+static HRESULT return_string(const WCHAR *str, WCHAR **out)
+{
+    if (!out)
+        return E_POINTER;
+    *out = CoTaskMemAlloc((wcslen(str) + 1) * sizeof(WCHAR));
+    if (!*out)
+        return E_OUTOFMEMORY;
+    wcscpy(*out, str);
+    return S_OK;
+}
+
+static const WCHAR *part_device_id(BOOL adapter, const WCHAR *endpoint_id)
+{
+    return adapter ? adapter_idW : endpoint_id;
+}
+
+static UINT connector_local_id(BOOL adapter)
+{
+    return adapter ? 0x00010001 : 0x00010000;
+}
+
+static HRESULT connector_global_id(BOOL adapter, const WCHAR *endpoint_id, WCHAR **out)
+{
+    const WCHAR *devid = part_device_id(adapter, endpoint_id);
+    size_t len = wcslen(devid) + 10;
+
+    if (!out)
+        return E_POINTER;
+    *out = CoTaskMemAlloc(len * sizeof(WCHAR));
+    if (!*out)
+        return E_OUTOFMEMORY;
+    swprintf(*out, len, L"%s/%08x", devid, connector_local_id(adapter));
+    return S_OK;
+}
+
+static inline IConnectorImpl *impl_from_IPart(IPart *iface)
+{
+    return CONTAINING_RECORD(iface, IConnectorImpl, IPart_iface);
+}
